        ``OnDockDrop`` is an event handler of type `Vcl.Controls.TDockDropEvent <Vcl.Controls.TDockDropEvent.htm>`__.
        '''
    def OnDockOver(self, Sender: Object, Source: DragDockObject, X: int, Y: int, State: DragState, Accept: bool) -> None:
