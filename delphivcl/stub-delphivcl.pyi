        ``OnCustomDrawButton`` is an event handler of type `Vcl.ComCtrls.TTBCustomDrawBtnEvent <Vcl.ComCtrls.TTBCustomDrawBtnEvent.htm>`__.
        '''
    def OnCustomizeAdded(self, Sender: Object, Button: ToolButton) -> None:
        '''
