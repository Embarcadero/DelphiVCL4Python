        ``OnAdvancedCustomDraw`` is an event handler of type `Vcl.ComCtrls.TTVAdvancedCustomDrawEvent <Vcl.ComCtrls.TTVAdvancedCustomDrawEvent.htm>`__.
        '''
    def OnAdvancedCustomDrawItem(self, Sender: CustomTreeView, Node: TreeNode, State: CustomDrawState, Stage: CustomDrawStage, PaintImages: bool, DefaultDraw: bool) -> None:
