    def UpdateItems(self) -> None:
        '''
        Causes all menu items to update themselves.

        ``UpdateItems()`` is called automatically when changes occur that must be reflected by individual menu items. Changes that affect the menu as a whole trigger the `MenuChanged <Vcl.Menus.TMenu.MenuChanged.htm>`__ method instead.
        '''
