        .. note:: Changes that affect individual items rather than the menu as a whole trigger the ``UpdateItems()`` method instead of ``MenuChanged()``. For example, when the ``Images`` property changes, ``UpdateItems()`` is called rather than ``MenuChanged()``.
        '''
    def Notification(self, AComponent: Component, Operation: Operation) -> None:
        '''
        Responds when components are added or deleted.

        `Menu <Vcl.Menus.TMenu.htm>`__ overrides the inherited method to set the ``Images`` property to ``nil`` (Delphi) or ``NULL`` (C++) if the ``ImageList`` is deleted.
        '''
    def SetChildOrder(self, Child: Component, Order: int) -> None:
