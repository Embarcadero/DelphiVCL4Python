        ``OnGetImageIndex`` is an event handler of type `Vcl.ComCtrls.TTabGetImageEvent <Vcl.ComCtrls.TTabGetImageEvent.htm>`__.
        '''
    def OnGetSiteInfo(self, Sender: Object, DockClient: Control, InfluenceRect: Rect, MousePos: Point, CanDock: bool) -> None:
